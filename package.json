{
  "name": "nimmit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run powersync:setup",
    "start": "ng serve",
    "prebuild": "npm run powersync:setup",
    "build": "ng build",
    "prebuild:pages": "npm run powersync:setup",
    "build:pages": "ng build --configuration production --base-href /syt5-gek1051-mobile-application-nimmit/",
    "powersync:setup": "npx powersync-web copy-assets -o src/assets",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:component": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=lcov --coverage-reporters=text-summary --coverage-reporters=json-summary",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "cap:init:ios": "npx cap add ios",
    "cap:init:android": "npx cap add android",
    "cap:sync": "ng build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.1.4",
    "@capacitor-community/bluetooth-le": "^8.1.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@jsverse/transloco": "^8.3.0",
    "@supabase/supabase-js": "^2.99.1",
    "fuse.js": "^7.1.0",
    "lucide-angular": "^0.577.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@capacitor/cli": "^8.1.0",
    "@cloudflight/eslint-plugin-angular": "^1.3.3",
    "@eslint/compat": "^2.0.3",
    "@journeyapps/wa-sqlite": "^1.5.0",
    "@powersync/web": "^1.36.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "cypress": "^15.12.0",
    "eslint": "^9.39.4",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "supabase": "^2.76.11",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
